# Copie para .env e informe credenciais locais; não versione o arquivo .env.
# O docker-compose usa POSTGRES_PASSWORD para o banco e a conexão da API.
POSTGRES_DB=contae
POSTGRES_USER=contae
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
API_PORT=8080

# Gere uma chave aleatória com pelo menos 32 bytes para HS256/JJWT.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION=86400000

# Para executar a API fora do Compose, configure também:
DB_URL=jdbc:postgresql://localhost:5432/contae
DB_USERNAME=contae
DB_PASSWORD=change-me-locally
